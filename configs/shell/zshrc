# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Theme (tinty) - rendered palettes live outside the repo; every hook below is optional.
TINTY_ARTIFACTS="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty/artifacts"

# fzf: hand tinted-fzf's --color flags to fzf-zsh-plugin, which builds FZF_DEFAULT_OPTS itself.
if [[ -r "$TINTY_ARTIFACTS/fzf-sh-file.sh" ]]; then
  FZF_DEFAULT_OPTS=""
  source "$TINTY_ARTIFACTS/fzf-sh-file.sh"
  export FZF_COLOR_SCHEME="$FZF_DEFAULT_OPTS"
  unset FZF_DEFAULT_OPTS
fi

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
    git
    gh
    macos
    brew
    fzf-zsh-plugin
)

# Homebrew Plugins
if command -v brew >/dev/null 2>&1; then
  _brew_prefix="$(brew --prefix)"
  [[ -r "${_brew_prefix}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
    source "${_brew_prefix}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  fpath=("${_brew_prefix}/share/zsh-completions" $fpath)
fi

# Docker CLI Completions
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)

autoload -Uz compinit
compinit

source "$ZSH/oh-my-zsh.sh"

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
[[ ! -r "$TINTY_ARTIFACTS/p10k-build-file.zsh" ]] || source "$TINTY_ARTIFACTS/p10k-build-file.zsh"

if command -v vivid >/dev/null 2>&1; then
  if [[ -r "$TINTY_ARTIFACTS/vivid-themes-file.yml" ]]; then
    export LS_COLORS="$(vivid generate "$TINTY_ARTIFACTS/vivid-themes-file.yml")"
  else
    export LS_COLORS="$(vivid generate catppuccin-mocha)"
  fi
fi
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)

# lazygit: on macOS it defaults to ~/Library/Application Support; use the linked ~/.config/lazygit
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"
# Theme: layer the theme engine's lazygit colors on top (comma-separated files merge)
[[ -r "$TINTY_ARTIFACTS/lazygit-themes-file.yml" ]] && LG_CONFIG_FILE="$LG_CONFIG_FILE,$TINTY_ARTIFACTS/lazygit-themes-file.yml"

if command -v brew >/dev/null 2>&1; then
  [[ -r "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
    source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

for alias_file in ~/.config/aliases/*.sh; do
    [[ -r "$alias_file" ]] && source "$alias_file"
done

# 1Password CLI Plugins
[[ -r "$HOME/.config/op/plugins.sh" ]] && source "$HOME/.config/op/plugins.sh"

# Lerd
[[ -d "$HOME/.local/share/lerd/bin" ]] && export PATH="$HOME/.local/share/lerd/bin:$PATH"
[[ -d "$HOME/.local/share/zsh/site-functions" ]] && fpath=("$HOME/.local/share/zsh/site-functions" $fpath)

# Lerd
export PATH="/Users/raven/.local/share/lerd/bin:$PATH"

# Lerd Completions
fpath=(/Users/raven/.local/share/zsh/site-functions $fpath)
autoload -Uz compinit && compinit

